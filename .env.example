# Anthropic (server-side only)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
# USD per million tokens; check current prices before changing the model
AI_PRICE_INPUT_PER_MTOK=4
AI_PRICE_OUTPUT_PER_MTOK=20
AI_PRICE_CACHE_WRITE_PER_MTOK=5
AI_PRICE_CACHE_READ_PER_MTOK=0.20
DAILY_SPEND_CAP_USD=15
# The platform-wide daily ceiling, in US dollars, over everything billed to the founder (default 100).
PLATFORM_DAILY_SPEND_CAP_USD=
# The platform: invites, customers and the public sign-up page (/signup). false (the default) keeps all of it off.
PLATFORM_ENABLED=
# The founder's name on invite emails and the sign-up page (default WA Agent).
PLATFORM_FOUNDER_NAME=
# With the platform on: the most customer runtimes at once, the founder included (default 20), and the memory in MB
# above which no customer runtime starts (default 4096).
PLATFORM_MAX_ACTIVE=
PLATFORM_MAX_RSS_MB=

# Google OAuth client of type "Desktop app"
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Timing
QUIET_MINUTES=4
MAX_WAIT_MINUTES=20
MAX_PARALLEL_CLIENTS=3

# Paths and logging
DATA_DIR=data
GROUPS_FILE=config/allowed-groups.json
LOG_LEVEL=info

# Speech-to-text, shared by voice notes and meetings (also read by the bake-off).
# local, sarvam, elevenlabs, openai or none (default none: nothing is transcribed, no spend).
# STT_PROVIDER=local sends meetings through the local engine too (the STT_LOCAL_* settings below): no key, no spend.
STT_PROVIDER=none
# The chosen provider's key. Required unless STT_PROVIDER is none or local. Server-side secret: type it into .env yourself.
STT_API_KEY=
# Rupees per US dollar, for Sarvam's rupee prices (default 88, allowed 40-200).
INR_PER_USD=88
# Longest voice note or audio file to transcribe, in seconds, measured on the converted audio (default 600, allowed 30-900).
STT_MAX_SECONDS=600
# Full path to ffmpeg.exe when ffmpeg is not on PATH.
FFMPEG_PATH=

# Voice notes only (docs/SETUP-mac.md, "Voice notes: local speech-to-text").
# local, sarvam, elevenlabs, openai or none (default none: voice notes are not transcribed).
# local runs an open-source model on this machine and needs no key. A paid one must be the same as STT_PROVIDER.
VOICE_STT_PROVIDER=none

# The local engine, used by VOICE_STT_PROVIDER=local and STT_PROVIDER=local (docs/SETUP-mac.md).
# The local model: voxtral, qwen3-asr or whisper (default voxtral).
STT_LOCAL_ENGINE=voxtral
# Full paths to the engine program (transcribe-cli; whisper-cli for whisper) and to its model file. Required when STT_PROVIDER or VOICE_STT_PROVIDER is local.
STT_LOCAL_BIN=
STT_LOCAL_MODEL=
# CPU threads the engine uses (default 8, allowed 1-64).
STT_LOCAL_THREADS=8
# Longest one run of the engine (a voice note, or one ten-minute meeting part) may take, in seconds (default 1800, allowed 60-7200).
# With STT_PROVIDER=local keep it at least 1200, or every meeting part is stopped before it finishes.
STT_LOCAL_TIMEOUT_SECONDS=1800
# hi, en or auto (default hi). qwen3-asr always detects the language itself.
STT_LOCAL_LANGUAGE=hi

# Meetings (Phase 3). After turning them on, run google-auth again to grant the meeting permissions.
# true or false (default false: no Google meeting call at all).
MEETINGS_ENABLED=false
# Our own email domains, comma-separated (e.g. ourstudio.in). Required when meetings are on. No public domains such as gmail.com.
TEAM_EMAIL_DOMAINS=
# How often to look for new recordings, in minutes (default 5, allowed 2-60).
MEETING_POLL_MINUTES=5
# Longer meetings are listed as too long and not transcribed, in minutes (default 180, allowed 10-300).
MEETING_MAX_MINUTES=180
# Optional YYYY-MM-DD: only meetings from this day on. Empty means from the day meetings were first switched on.
MEETINGS_SINCE=

# Phase 2b STT bake-off only (scripts/stt-bakeoff.ts, docs/STT-BAKEOFF.md).
# Keys are server-side secrets: type them into .env yourself, never into chat or code.
SARVAM_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
# Folder holding voice-notes\ and meetings\ (default C:\stt-samples). Must be outside every git repository.
STT_SAMPLES_DIR=

# Morning report from the spare number (docs/SETUP.md, "Morning report").
# REPORT_ENABLED=true turns it on. REPORT_TIME and REPORT_DEADLINE are IST (HH:MM); empty means 06:00 and 12:00.
# REPORT_RECIPIENT is the founder's Indian mobile: 91 then the 10 digits (12 digits in all), no + or spaces.
REPORT_ENABLED=
REPORT_TIME=
REPORT_DEADLINE=
# REPORT_DAYS: weekdays (Monday to Friday, the default when empty), mon-sat or daily.
REPORT_DAYS=
REPORT_RECIPIENT=

# Optional uptime monitoring (docs/SETUP-mac.md, "Uptime monitoring"). Paste the UptimeRobot heartbeat link here.
# The agent visits it every 5 minutes while it is working; when the visits stop, UptimeRobot alerts you. Keep it secret.
HEARTBEAT_URL=

# Owner dashboard (web page on the Mac). Off unless DASHBOARD_ENABLED=true, which also needs the owner emails and the web client.
DASHBOARD_ENABLED=
# Port on 127.0.0.1 only, never the office network (default 8787, allowed 1024-65535).
DASHBOARD_PORT=
# The address owners open: an https:// link, or http://localhost:8787 on the Mac itself.
DASHBOARD_PUBLIC_URL=
# Google accounts allowed to sign in, comma-separated (e.g. owner@ourstudio.in,second@ourstudio.in).
DASHBOARD_OWNER_EMAILS=
# The dashboard's own Google "Web application" OAuth client, not the desktop one above. Secret: type it here yourself.
DASHBOARD_GOOGLE_CLIENT_ID=
DASHBOARD_GOOGLE_CLIENT_SECRET=
# The dashboard's AI assistant: on with the dashboard; set it to false to switch it off. Its answers are paid Claude calls under DAILY_SPEND_CAP_USD.
DASHBOARD_ASSISTANT=
# Set true to send invites from the founder's Gmail; needs the gmail.send permission and Google test users until review.
INVITES_GMAIL=
# Optional UptimeRobot read-only API key, for the uptime history. Empty uses the agent's own log. Keep it secret.
UPTIMEROBOT_READ_KEY=

# SaaS S2: where the data lives. Empty or sqlite: data/tracker.db, as before. postgres: the Postgres server on this machine.
DB_ENGINE=
# With postgres: each role's URL, postgres://<role>:<password>@127.0.0.1:5432/wa_agent (this machine only). Secrets: type them here yourself.
# The agent connects as wa_app (customer data) and wa_platform (the platform tables); db-migrate as wa_owner.
DATABASE_URL=
DATABASE_PLATFORM_URL=
DATABASE_OWNER_URL=
# The customer this agent runs as on Postgres. Empty: customer #1 (the founder).
TENANT_ID=
