# Anthropic (server-side only)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
# USD per million tokens; check current prices before changing the model
AI_PRICE_INPUT_PER_MTOK=4
AI_PRICE_OUTPUT_PER_MTOK=20
AI_PRICE_CACHE_WRITE_PER_MTOK=5
AI_PRICE_CACHE_READ_PER_MTOK=0.20
DAILY_SPEND_CAP_USD=15

# Google OAuth client of type "Desktop app"
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Timing
QUIET_MINUTES=4
MAX_WAIT_MINUTES=20
MAX_PARALLEL_CLIENTS=3

# Paths and logging
DATA_DIR=data
GROUPS_FILE=config/allowed-groups.json
LOG_LEVEL=info

# Speech-to-text, shared by voice notes and meetings (also read by the bake-off).
# sarvam, elevenlabs, openai or none (default none: nothing is transcribed, no spend).
STT_PROVIDER=none
# The chosen provider's key. Required unless STT_PROVIDER=none. Server-side secret: type it into .env yourself.
STT_API_KEY=
# Rupees per US dollar, for Sarvam's rupee prices (default 88, allowed 40-200).
INR_PER_USD=88
# Longest voice note or audio file to transcribe, in seconds, measured on the converted audio (default 600, allowed 30-900).
STT_MAX_SECONDS=600
# Full path to ffmpeg.exe when ffmpeg is not on PATH.
FFMPEG_PATH=

# Meetings (Phase 3). After turning them on, run google-auth again to grant the meeting permissions.
# true or false (default false: no Google meeting call at all).
MEETINGS_ENABLED=false
# Our own email domains, comma-separated (e.g. ourstudio.in). Required when meetings are on. No public domains such as gmail.com.
TEAM_EMAIL_DOMAINS=
# How often to look for new recordings, in minutes (default 5, allowed 2-60).
MEETING_POLL_MINUTES=5
# Longer meetings are listed as too long and not transcribed, in minutes (default 180, allowed 10-300).
MEETING_MAX_MINUTES=180
# Optional YYYY-MM-DD: only meetings from this day on. Empty means from the day meetings were first switched on.
MEETINGS_SINCE=

# Phase 2b STT bake-off only (scripts/stt-bakeoff.ts, docs/STT-BAKEOFF.md).
# Keys are server-side secrets: type them into .env yourself, never into chat or code.
SARVAM_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
# Folder holding voice-notes\ and meetings\ (default C:\stt-samples). Must be outside every git repository.
STT_SAMPLES_DIR=
