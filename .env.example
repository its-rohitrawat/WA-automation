# Anthropic (server-side only)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
# USD per million tokens; check current prices before changing the model
AI_PRICE_INPUT_PER_MTOK=4
AI_PRICE_OUTPUT_PER_MTOK=20
AI_PRICE_CACHE_WRITE_PER_MTOK=5
AI_PRICE_CACHE_READ_PER_MTOK=0.20
DAILY_SPEND_CAP_USD=15

# Google OAuth client of type "Desktop app"
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Timing
QUIET_MINUTES=4
MAX_WAIT_MINUTES=20
MAX_PARALLEL_CLIENTS=3

# Paths and logging
DATA_DIR=data
GROUPS_FILE=config/allowed-groups.json
LOG_LEVEL=info

# Phase 2b STT bake-off only (scripts/stt-bakeoff.ts, docs/STT-BAKEOFF.md).
# Keys are server-side secrets: type them into .env yourself, never into chat or code.
SARVAM_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
# Full path to ffmpeg.exe when ffmpeg is not on PATH.
FFMPEG_PATH=
# Folder holding voice-notes\ and meetings\ (default C:\stt-samples). Must be outside every git repository.
STT_SAMPLES_DIR=
# Rupees per US dollar, for Sarvam's rupee prices (default 88).
INR_PER_USD=
